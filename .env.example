# ============================================================
# AgentHire AI - Environment Configuration
# Copy this file to .env and fill in real values
# ============================================================

# Database
MYSQL_ROOT_PASSWORD=root123
MYSQL_USER=agenthire
MYSQL_PASSWORD=agenthire123

# Redis
REDIS_PASSWORD=redis123

# JWT - generate a strong 256-bit secret for production!
JWT_SECRET=agenthire-super-secret-jwt-key-must-be-at-least-256-bits-long-for-hs256

# AI Providers (set ONE of these)
OPENAI_API_KEY=sk-your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
LLM_PROVIDER=openai

# Email (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=noreply@yourdomain.com
SMTP_PASSWORD=your-app-password

# OAuth2 (Google - create at console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123
